

# Alpine-Contributor: Carlo Landmeter <clandmeter@alpinelinux.org> 
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=xmlto
pkgver=0.0.29
pkgrel=2
pkgdesc="Convert xml to many other formats"
url="https://pagure.io/xmlto/"
arch="all"
license="GPL-2.0-or-later"
depends="libxslt perl bash docbook-xsl"
makedepends="autoconf automake"
subpackages=""
source="https://www.pagure.io/xmlto/archive/$pkgver/xmlto-$pkgver.tar.gz
disable-man-pages.patch"

prepare() {
    default_prepare

    autoreconf -fvi
}

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --mandir=/usr/share/man
    make -j1
}

check() {
    make check
}

package() {
    make -j1 DESTDIR="$pkgdir" install
}


